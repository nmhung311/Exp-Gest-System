# Frontend Environment Configuration for Local Development
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# API Configuration - Point to local backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:5012
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5012

# Application Configuration
NEXT_PUBLIC_APP_NAME=EXP Guest System
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true

# Development URLs
NEXT_PUBLIC_DEV_URL=http://localhost:3001
NEXT_PUBLIC_PROD_URL=http://your-domain.com
